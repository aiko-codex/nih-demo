Options -Indexes -ExecCGI

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|phar|php[0-9]+|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar
  RemoveType .php .phtml .phar
</IfModule>
